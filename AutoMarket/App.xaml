<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AutoMarket"
             xmlns:helpers="clr-namespace:AutoMarket.Helpers"
             x:Class="AutoMarket.App">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InputFieldBorderStyle" TargetType="Border">
                <Setter Property="Stroke" Value="#E0E0E0" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="HeightRequest" Value="50" />
            </Style>
            <helpers:DynamicTranslateConverter x:Key="DynamicTranslate"/>

            <Style TargetType="NavigationPage">
                <Setter Property="BarBackgroundColor" Value="#121212" />
                <Setter Property="BarTextColor" Value="White" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>