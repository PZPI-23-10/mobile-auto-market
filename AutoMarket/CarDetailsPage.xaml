<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:helpers="clr-namespace:AutoMarket.Helpers"
             xmlns:models="clr-namespace:AutoMarket.Models"
             x:Class="AutoMarket.CarDetailsPage"
             Title="Деталі авто"
             Shell.TabBarIsVisible="False" 
             BackgroundColor="White">

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,20">

                <Grid HeightRequest="300">
                    <CarouselView ItemsSource="{Binding Listing.Photos}"
                                  IndicatorView="indicatorView">
                        <CarouselView.ItemTemplate>
                            <DataTemplate x:DataType="models:ListingPhotoDto">
                                <Image Source="{Binding Url}" 
                                       Aspect="AspectFill" 
                                       HeightRequest="300"/>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <IndicatorView x:Name="indicatorView"
                                   IndicatorColor="LightGray"
                                   SelectedIndicatorColor="#80B918"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,10"/>

                    <ImageButton Command="{Binding BackCommand}"
                                 HorizontalOptions="Start" 
                                 VerticalOptions="Start"
                                 Margin="15,15,0,0" 
                                 HeightRequest="40" 
                                 WidthRequest="40"
                                 BackgroundColor="#80000000"
                                 CornerRadius="20">
                        <ImageButton.Source>
                            <FontImageSource Glyph="&lt;" Color="White" Size="30" FontFamily="OpenSansSemibold"/>
                        </ImageButton.Source>
                    </ImageButton>
                </Grid>

                <VerticalStackLayout Padding="20" Spacing="10">

                    <Label Text="{Binding Listing.FullTitle}" 
                           FontSize="24" FontAttributes="Bold" TextColor="Black"/>

                    <HorizontalStackLayout Spacing="10" VerticalOptions="End">
                        <Label Text="{Binding Listing.PriceUsdFormatted}" 
                               FontSize="26" FontAttributes="Bold" TextColor="#4CAF50"/>
                        <Label Text="•" TextColor="Gray" VerticalOptions="Center"/>
                        <Label Text="{Binding Listing.PriceUahFormatted}" 
                               FontSize="16" TextColor="Gray" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="#F0F0F0" Margin="0,5"/>

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="15" ColumnSpacing="10">

                        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="10">
                            <Label Text="⏱" FontSize="20" TextColor="#888"/>
                            <VerticalStackLayout>
                                <Label Text="{Binding Listing.Mileage, StringFormat='{0} км'}" FontAttributes="Bold" TextColor="Black"/>
                                <Label Text="{helpers:Translate CarDescriptionMileage}" FontSize="12" TextColor="Gray"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="10">
                            <Label Text="⛽" FontSize="20" TextColor="#888"/>
                            <VerticalStackLayout>
                                <Label Text="{Binding Listing.FuelType, Converter={StaticResource DynamicTranslate}, ConverterParameter='Fuel_'}" FontAttributes="Bold" TextColor="Black"/>
                                <Label Text="{helpers:Translate CarDescriptionFuelType}" FontSize="12" TextColor="Gray"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="10">
                            <Label Text="⚙️" FontSize="20" TextColor="#888"/>
                            <VerticalStackLayout>
                                <Label Text="{Binding Listing.GearType, Converter={StaticResource DynamicTranslate}, ConverterParameter='Gear_'}" FontAttributes="Bold" TextColor="Black"/>
                                <Label Text="{helpers:Translate CarDescriptionGear}" FontSize="12" TextColor="Gray"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="10">
                            <Label Text="📍" FontSize="20" TextColor="#888"/>
                            <VerticalStackLayout>
                                <Label Text="{Binding Listing.City, Converter={StaticResource DynamicTranslate}, ConverterParameter='City_'}" FontAttributes="Bold" TextColor="Black"/>
                                <Label Text="{helpers:Translate CarDescriptionCity}" FontSize="12" TextColor="Gray"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="10">
                            <Label Text="🔢" FontSize="20" TextColor="#888"/>
                            <VerticalStackLayout>
                                <Label Text="{Binding Listing.LicensePlate}" FontAttributes="Bold" TextColor="Black"/>
                                <Label Text="{helpers:Translate CarDescriptionLicensePlate}" FontSize="12" TextColor="Gray"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#F0F0F0" Margin="0,5"/>

                    <Label Text="{helpers:Translate CarDescriptionTitle}" FontAttributes="Bold" FontSize="18" TextColor="Black" Margin="0,10,0,5"/>
                    <Label Text="{Binding Listing.Description}" 
                           FontSize="15" TextColor="#333" LineHeight="1.2"/>

                    <Border Margin="0,15,0,0" 
                            StrokeShape="RoundRectangle 12"
                            Stroke="#28a745"
                            StrokeThickness="1"
                            BackgroundColor="#F0FFF4" 
                            Padding="15">   
                        <VerticalStackLayout Spacing="12">

                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Grid.Column="0" Text="🛡" TextColor="#28a745" FontSize="20" VerticalOptions="Center" Margin="0,0,10,0"/>

                                <VerticalStackLayout Grid.Column="1" Spacing="0">
                                    <Label Text="{helpers:Translate CheckByNumberTitle}" TextColor="Black" FontAttributes="Bold" FontSize="16"/>
                                    <Label Text="{helpers:Translate CheckByNumberSubtitle}" TextColor="Gray" FontSize="11"/>
                                </VerticalStackLayout>

                                <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="#28a745" StrokeShape="RoundRectangle 6" Padding="8,4" VerticalOptions="Center">
                                    <Label Text="{helpers:Translate CheckStatusClean}" TextColor="White" FontSize="10" FontAttributes="Bold"/>
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#28a745" Opacity="0.3"/>

                            <ActivityIndicator IsRunning="{Binding IsChecking}" IsVisible="{Binding IsChecking}" Color="#28a745"/>

                            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="15" ColumnSpacing="10"
                                  IsVisible="{Binding CheckInfo, Converter={toolkit:IsNotNullConverter}}">

                                <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                    <Label Text="{helpers:Translate CheckLabelMakeModel}" TextColor="#888" FontSize="10" FontAttributes="Bold"/>
                                    <Label Text="{Binding CheckInfo.Vendor}" TextColor="Black" FontSize="14" FontAttributes="Bold"/>
                                    <Label Text="{Binding CheckInfo.Model}" TextColor="Black" FontSize="14" FontAttributes="Bold"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                                    <Label Text="{helpers:Translate CheckLabelYear}" TextColor="#888" FontSize="10" FontAttributes="Bold"/>
                                    <Label Text="{Binding CheckInfo.Year}" TextColor="Black" FontSize="14" FontAttributes="Bold"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                                    <Label Text="{helpers:Translate CheckLabelColor}" TextColor="#888" FontSize="10" FontAttributes="Bold"/>
                                    <Label Text="{Binding CheckInfo.CleanColorName}" TextColor="Black" FontSize="14"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                    <Label Text="{helpers:Translate CheckLabelEngine}" TextColor="#888" FontSize="10" FontAttributes="Bold"/>
                                    <Label Text="{Binding CheckInfo.EngineCapacity}" TextColor="Black" FontSize="14"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="2" Grid.Column="0">
                                    <Label Text="{helpers:Translate CheckLabelDate}" TextColor="#888" FontSize="10" FontAttributes="Bold"/>
                                    <Label Text="{Binding CheckInfo.LastRegistrationDate}" TextColor="Black" FontSize="14"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2">
                                    <Label Text="{helpers:Translate CheckLabelOperation}" TextColor="#888" FontSize="10" FontAttributes="Bold"/>
                                    <Label Text="{Binding CheckInfo.LastOperationName}" TextColor="Black" FontSize="13"/>
                                </VerticalStackLayout>

                            </Grid>

                            <Label Text="{helpers:Translate CheckInfoNotFound}" TextColor="Gray" HorizontalOptions="Center"
                                   IsVisible="{Binding CheckInfo, Converter={toolkit:IsNullConverter}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsChecking}" Value="True">
                                        <Setter Property="IsVisible" Value="False"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                        </VerticalStackLayout>
                    </Border>
                    <Label Text="📍 Розташування авто" 
                            FontSize="18" 
                            FontAttributes="Bold" 
                            TextColor="Black"
                            Margin="0,20,0,10"/>        

                    <Grid HeightRequest="200" Margin="0,0,0,20">

                        <Border StrokeShape="RoundRectangle 10" StrokeThickness="0">
                            <WebView x:Name="CarMapWebView" 
                                      Source="map_details.html" 
                                      HeightRequest="200"/> 
                        </Border>

                        <Button BackgroundColor="Transparent"
             HeightRequest="200"
             Command="{Binding OpenFullMapCommand}"/>
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" StrokeThickness="0" BackgroundColor="White" Padding="15,10" Shadow="{Shadow Brush=Black, Opacity=0.2, Radius=5}">
        <Grid ColumnDefinitions="Auto, *">
            <Border Grid.Column="0" Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" 
                        HeightRequest="50" WidthRequest="50" StrokeShape="RoundRectangle 8" Margin="0,0,10,0">
                <Label Text="♡" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#555"/>
            </Border>

            <Button Grid.Column="1" 
                        Text="{Binding Listing.Number, StringFormat=' Написати повідомлення'}"
                        Command="{Binding WriteCommand}"
                        BackgroundColor="#28a745"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="8"
                        HeightRequest="50"/>
        </Grid>
        </Border>
    </Grid>
</ContentPage>