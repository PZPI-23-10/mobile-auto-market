<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoMarket.FullMapPage"
             Title="Мапа"
             BackgroundColor="White"
             Shell.TabBarIsVisible="False">
    <Grid>
        <WebView x:Name="FullMapView" Source="map_details.html" Navigated="OnMapNavigated" />

        <VerticalStackLayout VerticalOptions="Center" 
                             HorizontalOptions="End" 
                             Margin="0,0,15,0" 
                             Spacing="15">
           

            <Button Text="+" TextColor="Black" FontSize="24" BackgroundColor="White"
                    FontAttributes="Bold" WidthRequest="50" HeightRequest="50" CornerRadius="25" Padding="0"
                    Clicked="OnZoomInClicked"
                    Shadow="{Shadow Brush=Black, Radius=5, Opacity=0.3}"/>

            <Button Text="–" TextColor="Black" FontSize="24" BackgroundColor="White"
                    FontAttributes="Bold" WidthRequest="50" HeightRequest="50" CornerRadius="25" Padding="0"
                    Clicked="OnZoomOutClicked"
                    Shadow="{Shadow Brush=Black, Radius=5, Opacity=0.3}"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>