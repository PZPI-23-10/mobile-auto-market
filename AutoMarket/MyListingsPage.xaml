<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AutoMarket.ViewModel"
             xmlns:helpers="clr-namespace:AutoMarket.Helpers"
             xmlns:models="clr-namespace:AutoMarket.Models"
             x:Class="AutoMarket.Views.MyListingsPage"
             Title="{helpers:Translate PageTitle_MyListings}"
             BackgroundColor="#F5F5F5">

    <Grid>
        <ActivityIndicator IsRunning="{Binding IsBusy}" 
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" 
                           Color="Blue"
                           ZIndex="1"/>

        <CollectionView ItemsSource="{Binding MyListings}"
                        SelectionMode="None"
                        Margin="0,10,0,0">

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="30">
                    <Label Text="📂" FontSize="50" HorizontalOptions="Center"/>
                    <Label Text="{helpers:Translate MyListings_Empty}" 
                           FontSize="18" TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CarListing">
                    <VerticalStackLayout Padding="20, 0, 20, 5">
                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1">
                            <Grid RowDefinitions="200, Auto, Auto">
                                <Image Grid.Row="0" Source="{Binding CurrentPhotoUrl}" Aspect="AspectFill" HeightRequest="200"/>

                                <StackLayout Grid.Row="1" Padding="15">
                                    <Label Text="{Binding FullTitle}" TextColor="Black" FontSize="18" FontAttributes="Bold"/>

                                    <HorizontalStackLayout Spacing="8" Margin="0,5">
                                        <Label Text="{Binding PriceUsdFormatted}" TextColor="#4CAF50" FontSize="20" FontAttributes="Bold"/>
                                    </HorizontalStackLayout>

                                    <Label Text="{helpers:Translate Listing_StatusActive}" TextColor="Green" FontSize="12"/>
                                </StackLayout>

                                <Button Grid.Row="2"
                                        Text="{helpers:Translate Listing_DeleteButton}"
                                        BackgroundColor="#E64444"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        CornerRadius="0"
                                        HeightRequest="50"
                                        Margin="0, 5, 0, 0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MyListingsViewModel}}, Path=DeleteListingCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>